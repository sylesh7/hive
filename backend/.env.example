# ── Base Sepolia RPC ──────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Demo wallet private key (funded with test ETH on Base Sepolia) ────────────
# Get test ETH from: https://www.alchemy.com/faucets/base-sepolia
# This key is used for ERC-8004 registration transactions (client agent)
CLIENT_WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Groq API Key ──────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Groq Model ───────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile

# ── AXL binary path ───────────────────────────────────────────────────────────
AXL_BINARY_PATH=./axl/node.exe

# ── WebSocket server port (frontend connects here) ────────────────────────────
WS_PORT=8765

# ── REST API port (frontend HTTP calls) ──────────────────────────────────────
REST_PORT=8766

# ── Auction defaults ─────────────────────────────────────────────────────────
DEFAULT_AUCTION_WINDOW_SECS=90
