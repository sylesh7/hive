# ══════════════════════════════════════════════════════════════════
# HiveBid .gitignore
# ══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# SECRETS & PRIVATE KEYS  (never commit these)
# ─────────────────────────────────────────────────────────────────

# Wallet private keys and env files
backend/.env
**/.env
!**/.env.example

# ─────────────────────────────────────────────────────────────────
# RUNTIME DATA  (auto-generated at runtime)
# ─────────────────────────────────────────────────────────────────

# Persisted task records (contain full task content, delivery payloads)
backend/tasks/

# ─────────────────────────────────────────────────────────────────
# AXL BINARY & BUILD ARTIFACTS
# ─────────────────────────────────────────────────────────────────


# Go build cache
*.test
*.out

# ─────────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────────

# Bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pyright/
pyrightconfig.json

# ─────────────────────────────────────────────────────────────────
# NODE / FRONTEND (for Person B)
# ─────────────────────────────────────────────────────────────────

node_modules/
.next/
.nuxt/
dist/
.output/
.cache/
*.local

# ─────────────────────────────────────────────────────────────────
# EDITORS & OS
# ─────────────────────────────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─────────────────────────────────────────────────────────────────
# LOGS & TEMP
# ─────────────────────────────────────────────────────────────────

*.log
*.pid
*.seed
*.tmp
*.temp
.scratch/
