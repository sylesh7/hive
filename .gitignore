# ══════════════════════════════════════════════════════════════════
# HiveBid .gitignore
# ══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# SECRETS & PRIVATE KEYS  (never commit these)
# ─────────────────────────────────────────────────────────────────

# Wallet private keys and env files
backend/.env
**/.env
!**/.env.example

# AXL ed25519 private keys (generated per-machine by start.py)
backend/axl_nodes/**/private.pem

# AXL node configs contain absolute paths and peer addresses —
# they are auto-generated by start.py and machine-specific
backend/axl_nodes/**/node-config.json

# ERC-8004 on-chain identity (contains real token IDs and tx hashes)
backend/agents/client_agent/identity.json

# ─────────────────────────────────────────────────────────────────
# RUNTIME DATA  (auto-generated at runtime)
# ─────────────────────────────────────────────────────────────────

# Persisted task records (contain full task content, delivery payloads)
backend/tasks/

# ─────────────────────────────────────────────────────────────────
# AXL BINARY & BUILD ARTIFACTS
# ─────────────────────────────────────────────────────────────────

# Compiled AXL binary (large, OS-specific — built from axl-src/)
backend/axl/node.exe
backend/axl/node
backend/axl/*.exe

# AXL Go source (cloned separately — not part of this repo)
backend/axl-src/

# Go build cache
*.test
*.out

# ─────────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────────

# Bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pyright/
pyrightconfig.json

# ─────────────────────────────────────────────────────────────────
# NODE / FRONTEND (for Person B)
# ─────────────────────────────────────────────────────────────────

node_modules/
.next/
.nuxt/
dist/
.output/
.cache/
*.local

# ─────────────────────────────────────────────────────────────────
# EDITORS & OS
# ─────────────────────────────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─────────────────────────────────────────────────────────────────
# LOGS & TEMP
# ─────────────────────────────────────────────────────────────────

*.log
*.pid
*.seed
*.tmp
*.temp
.scratch/
